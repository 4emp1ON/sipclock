# Server-side secrets for the Sipclock stack. Generate on the server, never commit:
#   openssl rand -base64 32
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
# Password of the PowerSync replication role (see powersync-setup.sql). Hex only: it goes into URLs.
#   openssl rand -hex 24
POWERSYNC_DB_PASSWORD=

BETTER_AUTH_URL=https://4db4f06b3824.vps.myjino.ru
CORS_ORIGINS=https://sipclock.champ1ons.space,https://sipclock.vercel.app
# Jino's proxy appends the client address to X-Forwarded-For; the edge Caddy passes it through unchanged.
TRUST_PROXY_HOPS=1
RATE_LIMIT_RECOMMEND_PER_MIN=60
LOG_LEVEL=info
PUBLIC_BASE_URL=https://4db4f06b3824.vps.myjino.ru/sipclock
# API reference is served only with these set (HTTP Basic). Generate the password on the server.
API_DOCS_USERNAME=sipclock
API_DOCS_PASSWORD=
SENTRY_DSN=

# Accounts (required in production; the API refuses to start without them).
# Resend API key for sign-in codes (sending-only key). The sender domain sipclock.champ1ons.space is verified
# in Resend (DKIM/SPF/DMARC records in Jino DNS); onboarding@resend.dev would reach only the account owner.
RESEND_API_KEY=
EMAIL_FROM=Sipclock <no-reply@sipclock.champ1ons.space>
# Shared with the web app (Vercel env EDGE_PROXY_SECRET): lets the API rate-limit web users by their own IP.
#   openssl rand -hex 32
EDGE_PROXY_SECRET=
# Must match client_auth.audience in infra/powersync/service.yaml.
POWERSYNC_AUDIENCE=sipclock-powersync
