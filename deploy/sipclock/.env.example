# Server-side secrets for the Sipclock stack. Generate on the server, never commit:
#   openssl rand -base64 32
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=

BETTER_AUTH_URL=https://4db4f06b3824.vps.myjino.ru
CORS_ORIGINS=https://sipclock.vercel.app
# Jino's proxy appends the client address to X-Forwarded-For; the edge Caddy passes it through unchanged.
TRUST_PROXY_HOPS=1
RATE_LIMIT_RECOMMEND_PER_MIN=60
LOG_LEVEL=info
PUBLIC_BASE_URL=https://4db4f06b3824.vps.myjino.ru/sipclock
# API reference is served only with these set (HTTP Basic). Generate the password on the server.
API_DOCS_USERNAME=sipclock
API_DOCS_PASSWORD=
SENTRY_DSN=
