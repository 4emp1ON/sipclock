# Copy to .env.local. EXPO_PUBLIC_* values are inlined into the JS bundle: never put secrets here.
EXPO_PUBLIC_SENTRY_DSN=
# Leave empty for the defaults (src/lib/endpoints.ts): dev builds use the dev machine
# (http://localhost:8787 on iOS, http://10.0.2.2:8787 on the Android emulator), release builds production.
# On a physical device set your machine's LAN address, e.g. http://192.168.1.20:8787.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_POWERSYNC_URL=
