{
  "name": "@sipclock/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "start": "node src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:migrate:prod": "node src/migrate.ts",
    "build": "node scripts/bundle.ts",
    "evals": "node evals/run.ts",
    "evals:mock": "EVALS_MOCK=1 node evals/run.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.69",
    "@ai-sdk/openai-compatible": "3.0.60",
    "@hono/node-server": "2.1.3",
    "@hono/zod-openapi": "1.6.3",
    "@scalar/hono-api-reference": "0.12.7",
    "@sentry/node": "11.1.0",
    "@sipclock/catalog": "workspace:*",
    "@sipclock/domain": "workspace:*",
    "@sipclock/engine": "workspace:*",
    "@sipclock/i18n": "workspace:*",
    "ai": "7.0.123",
    "better-auth": "1.7.6",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.11",
    "mmdb-lib": "3.0.3",
    "postgres": "3.4.9",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "promptfoo": "0.123.1",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  }
}
