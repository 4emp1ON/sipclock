# Runtime environment (validated in src/env.ts). Copy to .env for local dev.

# development | test | production
NODE_ENV=development

# HTTP port
PORT=8787

# Postgres connection string (matches root docker-compose.yml defaults)
DATABASE_URL=postgres://sipclock:sipclock@localhost:5432/sipclock

# Better Auth signing secret, at least 32 chars. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-change-me-change-me-change-me

# Public base URL of this API (used by Better Auth for callbacks and cookies)
BETTER_AUTH_URL=http://localhost:8787

# Comma-separated list of allowed browser origins (CORS + Better Auth trustedOrigins)
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# Optional: Sentry DSN. Sentry is initialized only when set.
SENTRY_DSN=

# Number of reverse proxies in front of the API that append to X-Forwarded-For (0 = ignore the header).
# The client IP is taken that many entries from the right; client-supplied entries on the left are ignored.
TRUST_PROXY_HOPS=0

# Max POST /v1/recommendations requests per client IP per minute
RATE_LIMIT_RECOMMEND_PER_MIN=60

# debug | info | warn | error | silent
LOG_LEVEL=info

# Public URL of the API (with any path prefix); used as the OpenAPI server for "Try it".
PUBLIC_BASE_URL=
# HTTP Basic credentials for /docs and /openapi.json. In production the docs are hidden unless both are set.
API_DOCS_USERNAME=
API_DOCS_PASSWORD=

# Resend API key for email sign-in codes. Empty: codes are logged (outside production) instead of sent.
RESEND_API_KEY=
# Sender of sign-in code emails; must be a domain verified in Resend.
EMAIL_FROM="Sipclock <onboarding@resend.dev>"
# Audience of the JWTs issued for the PowerSync service (must match the PowerSync config).
POWERSYNC_AUDIENCE=sipclock-powersync
# Shared secret of the web app's server-side proxy (at least 32 chars). Requests carrying it in
# X-Sipclock-Proxy-Secret are rate limited by X-Sipclock-Client-Ip. Empty: that header is ignored.
EDGE_PROXY_SECRET=

# AI gateway (docs/adr/0007). Without YANDEX_API_KEY AI routes answer from the catalog only.
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=aliceai-llm/latest
# Claude for users never seen from Russia; called through a relay in a supported region.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_RELAY_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
# Country database (DB-IP Lite, mmdb). Empty: country unknown, every user is served by Yandex.
GEOIP_DB_PATH=
# AI requests per user per UTC day on the free plan
AI_FREE_DAILY_REQUESTS=50
# Monthly spend caps per provider
AI_BUDGET_YANDEX_RUB=1000
AI_BUDGET_ANTHROPIC_USD=10
